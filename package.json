{
  "name": "verbatim",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Transcribe video and audio entirely in your browser. Nothing is uploaded.",
  "license": "MIT",
  "scripts": {
    "build:wasm": "wasm-pack build crates/wasm --target web --release --out-dir ../../src/edl/pkg --out-name edl --no-pack",
    "dev": "bun run build:wasm && bun scripts/build.ts --serve",
    "build": "bun run build:wasm && bun scripts/build.ts",
    "check:network": "bun scripts/check-no-network.ts dist",
    "typecheck": "tsc --noEmit -p .",
    "lint": "oxlint --deny-warnings src scripts e2e",
    "test": "bun run build:wasm && bun test src scripts",
    "e2e": "playwright test",
    "catalog": "bun scripts/catalog.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.90",
    "@ai-sdk/google": "^4.0.107",
    "@ai-sdk/mistral": "^4.0.74",
    "@ai-sdk/openai": "^4.0.104",
    "@ai-sdk/openai-compatible": "^3.0.80",
    "@fontsource-variable/hanken-grotesk": "5.3.0",
    "@huggingface/transformers": "4.3.1",
    "ai": "^7.0.155",
    "fflate": "^0.8.3",
    "llm-connect": "2.5.0",
    "llm-models": "1.14.0",
    "mediabunny": "1.62.1",
    "onnxruntime-web": "1.31.0-dev.20260914-8d85527a0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/bun": "^1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "oxlint": "^1.90.0",
    "typescript": "7.0.2"
  }
}
